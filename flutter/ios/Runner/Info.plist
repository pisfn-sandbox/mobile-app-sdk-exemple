<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Permissions utilisées par le SDK PI-SPI (bceao_pispi_app) -->
	<key>NSCameraUsageDescription</key>
	<string>La caméra permet de scanner les QR codes PI-SPI.</string>
	<key>NSContactsUsageDescription</key>
	<string>L'accès à vos contacts permet d'envoyer de l'argent à un contact.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Votre position est utilisée pour vérifier vos transactions et prévenir la fraude.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>L'accès à vos photos permet d'importer un QR code ou un ticket de caisse.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Le micro permet de rechercher une fonctionnalité à la voix.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>La reconnaissance vocale transforme votre voix en texte pour la recherche.</string>
