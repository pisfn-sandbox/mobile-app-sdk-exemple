# Copiez ce fichier en `.env` pour appeler un vrai backend PI-SPI.
# Sans fichier .env, l'exemple tourne en mode démo (aucun appel réseau).
EXPO_PUBLIC_PISPI_DEMO_MODE=false
EXPO_PUBLIC_PISPI_API_BASE_URL=https://votre-backend-pispi.example.com/api
EXPO_PUBLIC_PISPI_PSP_CODE_MEMBRE=VOTRE_CODE_MEMBRE
